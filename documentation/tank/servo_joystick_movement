#include <Servo.h>  // Include the Servo library

Servo myServo;      // Create a Servo object

int joystickValue = 0;  // Variable to store the joystick value
int servoPosition = 0;  // Variable to store the servo position

// Define a wider dead zone range
int deadZoneCenter = 512;  // Joystick center (typically around 512)
int deadZoneRange = 0;    // Wider dead zone to handle fluctuations (you can adjust this as needed)

void setup() {
  myServo.attach(5);  // Attach the servo to pin 5
  Serial.begin(9600);  // Start serial communication for debugging
}

void loop() {
  joystickValue = analogRead(A0);  // Read the joystick value (0 to 1023)

  // Check if joystick value is within the dead zone (ignore small fluctuations)
  if (abs(joystickValue - deadZoneCenter) > deadZoneRange) {
    // Map the joystick value to the range 0-180 (for the servo)
    servoPosition = map(joystickValue, 0, 1023, 0, 100);
    myServo.write(servoPosition);  // Move the servo to the mapped position
  } else {
    // If joystick is within dead zone, don't move the servo
    myServo.write(90);  // Keep servo at center (90 degrees)
  }

  // Optionally, print the values for debugging
  Serial.print("Joystick Value: ");
  Serial.print(joystickValue);
  Serial.print("  Servo Position: ");
  Serial.println(servoPosition);

  delay(50);  // Small delay to allow the servo to move
}
